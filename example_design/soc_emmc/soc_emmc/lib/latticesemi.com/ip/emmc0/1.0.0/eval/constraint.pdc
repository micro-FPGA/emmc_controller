##================================================================================##
## Copy these constraints to your top-level pdc and replace path with actual path 
##================================================================================##
set CLKI_FREQ 50
set CLKI_PERIOD 20.0000
set SCK_DIV 500
set SCK_PERIOD 10000.0000
set SCK_PERIOD_D2 5000.0000

create_clock -name {clk_i} -period $CLKI_PERIOD [get_ports clk_i]
create_generated_clock -name {emmc_clk_o} -source [get_ports clk_i] -divide_by $SCK_DIV [get_ports emmc_clk_o]

set_input_delay -clock [get_clocks emmc_clk_o] $SCK_PERIOD_D2 [get_ports {emmc_cmd_io emmc_dat_io[*]}]
set_multicycle_path -setup -start -from [get_clocks clk_i]     -to [get_clocks emmc_clk_o] 500
set_multicycle_path -hold  -start -from [get_clocks clk_i]     -to [get_clocks emmc_clk_o] 499
set_multicycle_path -setup -end   -from [get_clocks emmc_clk_o] -to [get_clocks clk_i    ] 500
set_multicycle_path -hold  -end   -from [get_clocks emmc_clk_o] -to [get_clocks clk_i    ] 499
set_output_delay -clock [get_clocks emmc_clk_o] $SCK_PERIOD_D2 [get_ports {emmc_cmd_io emmc_dat_io[*]}]
set_false_path -from [get_ports  {rst_n_i}]
set_false_path -from [get_ports  {emmc_*}]
set_false_path -to   [get_ports  {emmc_*}]


##================================END OF CONSTRAINTS==============================##
##This is not necessary, added only for eval
ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {s_* m_*}]


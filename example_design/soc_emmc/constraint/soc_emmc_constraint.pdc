ldc_set_location -site {Y13} [get_ports {emmc_dat_io[7]}]

ldc_set_port -iobuf {SLEWRATE=FAST} [get_ports {emmc_clk_o}]
ldc_set_port -iobuf {SLEWRATE=FAST} [get_ports {emmc_rst_n_o}]

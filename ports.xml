    />

    <lsccip:port name          = "emmc_cmd_io"
                 dir           = "inout"
                 conn_mod      = "lscc_emmc_controller"
                 conn_port     = "emmc_cmd_io"
                 dangling      = "not (USE_IO_PRIMITIVE)"
    />

    <lsccip:port name          = "emmc_cmd_i"
                 dir           = "in"
                 conn_mod      = "lscc_emmc_controller"
                 conn_port     = "emmc_cmd_i"
                 stick_low     = "USE_IO_PRIMITIVE"
    />

    <lsccip:port name          = "emmc_cmd_o"
                 dir           = "out"
                 conn_mod      = "lscc_emmc_controller"
                 conn_port     = "emmc_cmd_o"
                 dangling      = "USE_IO_PRIMITIVE"
    />

    <lsccip:port name          = "emmc_cmd_oe_o"

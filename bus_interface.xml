                    <lsccip:portMap>
                        <lsccip:logicalPort>
                            <lsccip:name>HMASTLOCK</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>
                            <lsccip:name>m_ahbl_hmastlock_o</lsccip:name>
                        </lsccip:physicalPort>
                    </lsccip:portMap>

                    <!-- AHB-Lite Write Data -->
                    <lsccip:portMap>
                        <lsccip:logicalPort>
                            <lsccip:name>HWDATA</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>
                            <lsccip:name>m_ahbl_hwdata_o</lsccip:name>
                        </lsccip:physicalPort>
                    </lsccip:portMap>

                    <!-- AHB-Lite Transfer Response -->
                    <lsccip:portMap>
                        <lsccip:logicalPort>
                            <lsccip:name>HREADY</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>

<lsccip:busInterfaces xmlns:lsccip="http://www.latticesemi.com/XMLSchema/Radiant/ip">
    <!-- Interrupt Interface -->
    <lsccip:busInterface>
        <lsccip:name>INTR</lsccip:name>
        <lsccip:displayName>INTR</lsccip:displayName>
        <lsccip:description>Interrupt Request</lsccip:description>
        <lsccip:busType library="busdef.interrupt" name="interrupt" vendor="spiritconsortium.org" version="1.0"/>
        <lsccip:abstractionTypes>
            <lsccip:abstractionType>
                <lsccip:abstractionRef library="busdef.interrupt" name="interrupt_rtl" vendor="spiritconsortium.org" version="1.0"/>
                <lsccip:portMaps>
                     <lsccip:portMap>
                        <lsccip:logicalPort>
                            <lsccip:name>IRQ</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>
                            <lsccip:name>int_o</lsccip:name>
                        </lsccip:physicalPort>
                    </lsccip:portMap>
                </lsccip:portMaps>
            </lsccip:abstractionType>
        </lsccip:abstractionTypes>
        <lsccip:master/>
    </lsccip:busInterface>


                    </lsccip:portMap>
                    <lsccip:portMap>
                        <lsccip:logicalPort>
                            <lsccip:name>HRESP</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>
                            <lsccip:name>m_ahbl_hresp_i</lsccip:name>
                        </lsccip:physicalPort>
                    </lsccip:portMap>

                    <!-- AHB-Lite Read Data -->

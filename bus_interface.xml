                            <lsccip:name>HSIZE</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>
                            <lsccip:name>m_ahbl_hsize_o</lsccip:name>
                        </lsccip:physicalPort>
                    </lsccip:portMap>
                    <lsccip:portMap>
                        <lsccip:logicalPort>
                            <lsccip:name>HBURST</lsccip:name>
                        </lsccip:logicalPort>
                        <lsccip:physicalPort>
                            <lsccip:name>m_ahbl_hburst_o</lsccip:name>
                        </lsccip:physicalPort>
                    </lsccip:portMap>
                    <lsccip:portMap>
                        <lsccip:logicalPort>
